# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
# Claude Code files (local-only, never pushed)
.claude/
CLAUDE.md

test-output

# Next.js
.next
out

# Environment files (keep .env.example tracked, anywhere in the repo)
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Local Redis snapshots (can contain queued job payloads)
*.rdb
