# AcePay gateway configuration

PORT=4001
NODE_ENV=development

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=acepay
DB_SSL=false
DB_LOGGING=false

# Webhook secret encryption (AES-256-GCM, 32-byte hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Admin auth (HMAC-SHA256 signed tokens)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL_HOURS=12

# Seed admin user (used by `npm run seed:admin`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public-facing base URL of THIS gateway. Surfaced by /settings as the URL you
# paste into Lemon Squeezy + Xendit dashboards for webhooks. In dev with ngrok,
# set to your ngrok URL. In production, set to your appspot.com URL.
PUBLIC_BASE_URL=

# Allowed CORS origins for the admin (and any first-party app frontends).
# Comma-separated. Defaults to localhost:4000,localhost:3000 if unset.
CORS_ORIGINS=http://localhost:4000

# Provider credentials
# Lemon Squeezy: API key from app.lemonsqueezy.com → Settings → API.
# STORE_ID is your numeric store id (find it via dashboard URL or GET /v1/stores).
# Subscription variant IDs are NOT in .env — each AcePay Plan stores its own
# providerPlanId (the LS Variant ID) in the database.
# LEMONSQUEEZY_VARIANT_ID is the "Generic Charge" one-time-payment variant —
# only required if you re-enable POST /v1/payments (removed in Slice 3.6).
# Subscription plans do NOT use it; each plan carries its own LS variant id.
#
# LEMONSQUEEZY_TEST_MODE: only the exact lowercase string "false" goes live.
# Unset, "FALSE", "False" and " false" all keep you in the LS sandbox.
#
# LEMONSQUEEZY_WEBHOOK_SECRET is the signing secret for INBOUND webhooks
# (Lemon Squeezy -> AcePay at POST /v1/webhooks/lemonsqueezy). It is a single
# global value, not per-app — the per-app secret is a different thing, used for
# OUTBOUND delivery to each app's own webhook URL.
#
# You choose this string; LS does not generate it for you.
#
# The Lemon Squeezy dashboard caps its signing-secret field at 40 characters, so
# do NOT reuse the 32-byte recipe used for WEBHOOK_SECRET_ENCRYPTION_KEY — that
# produces 64 hex chars and the field will reject it. Use 16 bytes (32 hex
# chars, 128 bits), which is comfortably strong for an HMAC key and fits:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
#   Local testing, no public URL: put any random value here and leave it. Both
#   sides of the check are your own machine, so POST /admin/settings/simulate-webhook
#   signs with this value and the receiver verifies against it. Nothing needs to
#   be registered with LS for that to work.
#
#   Real LS deliveries: paste the SAME string into the LS dashboard under
#   Settings -> Webhooks, with the callback URL set to
#   <PUBLIC_BASE_URL>/v1/webhooks/lemonsqueezy. LS cannot reach localhost, so for
#   local work expose the gateway first (`cloudflared tunnel --url http://localhost:4001`
#   or `ngrok http 4001`) and set PUBLIC_BASE_URL to the URL it gives you.
#
#   Events to subscribe to (the twelve the handler understands): order_created,
#   order_refunded, subscription_created, subscription_updated,
#   subscription_cancelled, subscription_resumed, subscription_paused,
#   subscription_expired, subscription_payment_success,
#   subscription_payment_failed, subscription_payment_recovered,
#   subscription_payment_refunded.
#
# Leaving this blank does NOT fail at boot (validateEnv does not require it) —
# it fails at the first webhook with "LEMONSQUEEZY_WEBHOOK_SECRET env var is not set".
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_TEST_MODE=true

# Redis (Bull queues for the worker). Local default below; cloud Redis works too.
# For prod, use Upstash: rediss://default:<token>@<region>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Xendit: PH-local provider for cards + (Phase 2) GCash/Maya/GrabPay recurring.
# Get keys from dashboard.xendit.co → Settings → Developers → API Keys.
# XENDIT_WEBHOOK_TOKEN is the verification token from Settings → Webhooks.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Marketplace payments + payouts (Slice 6, xenPlatform). Only needed once an app
# has marketplace mode turned on in the admin.
# XENDIT_PLATFORM_ACCOUNT_ID: your MASTER account's Business ID (Xendit dashboard
#   → Settings → Business profile). Platform fees are routed here by split rules.
# XENDIT_PAYOUT_FEE_RESERVE: minor units left in each merchant's sub-account at
#   payout time to cover Xendit's payout fee (charged on top of the amount).
#   Default 2500 = ₱25. Set it to at least your actual Xendit payout fee.
# Your XENDIT_SECRET_KEY needs Money-out WRITE and Account WRITE permissions.
# Webhooks: point Payouts + xenPlatform (account, split payment) callbacks at
#   https://<gateway>/v1/webhooks/xendit/marketplace
XENDIT_PLATFORM_ACCOUNT_ID=
XENDIT_PAYOUT_FEE_RESERVE=2500

# Error tracking (optional). Leave SENTRY_DSN blank to disable Sentry entirely
# — the gateway + worker run fine without it. TRACES_SAMPLE_RATE is 0..1.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
