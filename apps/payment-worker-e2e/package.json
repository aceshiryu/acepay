{
  "name": "@ace-pay/payment-worker-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "payment-worker-e2e",
    "implicitDependencies": [
      "payment-worker"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/payment-worker-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "payment-worker:build",
          "payment-worker:serve"
        ]
      }
    }
  }
}
