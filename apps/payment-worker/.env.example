# AcePay payment-worker configuration
#
# In LOCAL DEV, the worker reads the gateway's .env file (see main.ts) — you
# do not need a worker .env locally. This file documents what env vars the
# worker needs in PRODUCTION, where cloudbuild generates a separate .env per
# service from Secret Manager.

PORT=4002
NODE_ENV=development

# Database (Postgres) — must point at the same database as the gateway.
# The worker reads subscription/customer/plan/transaction/webhook_event rows.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=acepay
DB_SSL=false
DB_LOGGING=false

# Redis — the worker drains the Bull queues populated by the gateway:
#   * webhook-delivery     → POSTs signed events to apps' webhook URLs
#   * subscription-billing → charges saved Xendit PMs on schedule
#   * reconcile-stale      → every 15 min sweep of pending transactions
# For prod, use Upstash: rediss://default:<token>@<region>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Webhook secret encryption (AES-256-GCM, 32-byte hex)
# MUST match the gateway's value — used to decrypt each app's webhook secret
# when signing outbound delivery payloads.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Lemon Squeezy adapter — loaded for completeness, but LS auto-bills its own
# subscriptions so the billing processor short-circuits for LS subs. Same
# values as the gateway.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_TEST_MODE=true

# Xendit adapter — used by SubscriptionBillingProcessor to charge saved
# PaymentMethod tokens (the actual recurring engine). Same values as the
# gateway.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
