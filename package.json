{
  "name": "@ace-pay/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "serve:gateway": "npx nx serve payment-gateway",
    "serve:worker": "npx nx serve payment-worker",
    "serve:admin": "npx nx dev payment-admin --port=4000",
    "serve:all": "npx nx run-many --targets=serve,dev --projects=payment-gateway,payment-worker,payment-admin",
    "build:gateway": "npx nx run payment-gateway:prune --skip-nx-cache",
    "build:worker": "npx nx run payment-worker:prune --skip-nx-cache",
    "build:admin": "npx nx build payment-admin --skip-nx-cache",
    "create-env": "node scripts/create-env.js",
    "db:migrate": "TS_NODE_PROJECT=apps/payment-gateway/tsconfig.app.json npx typeorm-ts-node-commonjs -d apps/payment-gateway/src/database/data-source.ts migration:run",
    "db:revert": "TS_NODE_PROJECT=apps/payment-gateway/tsconfig.app.json npx typeorm-ts-node-commonjs -d apps/payment-gateway/src/database/data-source.ts migration:revert",
    "db:generate": "TS_NODE_PROJECT=apps/payment-gateway/tsconfig.app.json npx typeorm-ts-node-commonjs -d apps/payment-gateway/src/database/data-source.ts migration:generate apps/payment-gateway/src/database/migrations/Generated",
    "seed:admin": "TS_NODE_PROJECT=apps/payment-gateway/tsconfig.app.json npx ts-node apps/payment-gateway/src/database/seed-admin.ts"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "22.7.2",
    "@nx/eslint-plugin": "22.7.2",
    "@nx/jest": "22.7.2",
    "@nx/js": "22.7.2",
    "@nx/nest": "^22.7.2",
    "@nx/next": "^22.7.2",
    "@nx/node": "^22.7.2",
    "@nx/web": "22.7.2",
    "@nx/webpack": "22.7.2",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bull": "^3.15.9",
    "@types/jest": "~30.0.0",
    "@types/node": "20.19.9",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "babel-jest": "~30.3.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.2",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "tailwindcss": "3.4.3",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.6.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "next": "~16.1.6",
    "pg": "^8.13.1",
    "xendit-node": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  }
}
